#!/usr/bin/env python3
"""Merge the owned agent settings without replacing machine-specific settings."""

import argparse
import json
import os
from pathlib import Path
import re
import stat
import tempfile
try:
    import tomllib
except ModuleNotFoundError:
    raise SystemExit('agent-settings-sync requires Python 3.11 or later. Install Homebrew Python before chezmoi apply.')


def disable_toml_plugin(text, name):
    quoted_name = r'(?:"' + re.escape(name) + r'"|\x27' + re.escape(name) + r'\x27)'
    header = re.compile(r'^[ \t]*\[[ \t]*plugins[ \t]*\.[ \t]*' + quoted_name + r'[ \t]*\][ \t]*(?:#.*)?$', re.M)
    match = header.search(text)
    if match is None:
        return text.rstrip() + '\n\n[plugins.' + json.dumps(name) + ']\nenabled = false\n'
    next_table = re.search(r'^\[', text[match.end():], re.M)
    end = match.end() + next_table.start() if next_table else len(text)
    block = text[match.start():end]
    enabled = re.compile(r'^([ \t]*enabled[ \t]*=[ \t]*)(?:true|false)([ \t]*(?:#.*)?)$', re.M)
    if enabled.search(block):
        block = enabled.sub(r'\g<1>false\g<2>', block, count=1)
    else:
        block = block.rstrip() + '\nenabled = false\n\n'
    return text[:match.start()] + block + text[end:]


def prepare(root, policy):
    claude = root / '.claude/settings.json'
    codex = root / '.codex/config.toml'
    old_json = claude.read_text() if claude.exists() else '{}\n'
    old_toml = codex.read_text() if codex.exists() else ''
    settings = json.loads(old_json)
    config = tomllib.loads(old_toml)
    auto_mode = settings.setdefault('autoMode', {})
    preserved_slots = policy.get('preserve_environment_slots', [])
    local_entries = [entry for entry in auto_mode.get('environment', [])
                     if entry.replace('**', '').split(':', 1)[0].strip() in preserved_slots]
    auto_mode['environment'] = policy['claude_auto_environment'] + local_entries
    changed_toml = old_toml
    for name in policy['disabled_plugins']:
        settings.setdefault('enabledPlugins', {})[name] = False
        changed_toml = disable_toml_plugin(changed_toml, name)
        config.setdefault('plugins', {}).setdefault(name, {})['enabled'] = False
    if tomllib.loads(changed_toml) != config:
        raise ValueError('Codex settings changed outside the requested plugin fields')
    return [(claude, old_json, json.dumps(settings, ensure_ascii=False, indent=2) + '\n'),
            (codex, old_toml, changed_toml)]


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--home', type=Path, default=Path.home())
    parser.add_argument('--policy', type=Path)
    parser.add_argument('--dry-run', action='store_true')
    args = parser.parse_args()
    policy_path = args.policy or args.home / '.agents/settings-policy.json'
    policy = json.loads(policy_path.read_text())
    if '$defaults' not in policy['claude_auto_environment']:
        raise ValueError('The environment must retain $defaults')
    if not all(isinstance(name, str) and '@' in name for name in policy['disabled_plugins']):
        raise ValueError('Plugin names must include their marketplace')
    updates = prepare(args.home, policy)
    for path, old, new in updates:
        if old == new:
            continue
        if args.dry_run:
            print('would update', path)
            continue
        if path.exists() and path.read_text() != old:
            raise RuntimeError(f'Settings changed during preparation: {path}')
        path.parent.mkdir(parents=True, exist_ok=True)
        mode = stat.S_IMODE(path.stat().st_mode) if path.exists() else 0o600
        descriptor, temporary = tempfile.mkstemp(dir=path.parent, prefix='.' + path.name + '.')
        try:
            with os.fdopen(descriptor, 'w') as handle:
                handle.write(new)
            os.chmod(temporary, mode)
            os.replace(temporary, path)
        finally:
            if os.path.exists(temporary):
                os.unlink(temporary)
        print('updated', path)


if __name__ == '__main__':
    main()
