# PATH の重複を毎シェル除去
typeset -U path PATH

# XDG base directories
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"

# Local paths
export PATH="$HOME/.local/bin:$PATH"

# mise shims: .zshrc's `mise activate` only runs in interactive shells, so
# non-interactive subshells (e.g. Claude Code's Bash tool) would otherwise
# fall back to /opt/homebrew/bin/node and miss the version pinned in mise.
[ -d "$HOME/.local/share/mise/shims" ] && export PATH="$HOME/.local/share/mise/shims:$PATH"

# Cargo (rustup). Skip on machines without rustup.
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# Locale
export LANG="en_US.UTF-8"

# Editor
export VISUAL="zed --wait"
export EDITOR="$VISUAL"
export GIT_EDITOR="$EDITOR"
