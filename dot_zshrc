# Shell behavior
umask 022
limit coredumpsize 0
bindkey -e

# Homebrew
if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# History
HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000
setopt extended_history
setopt hist_ignore_all_dups
setopt hist_ignore_space
setopt hist_verify
setopt hist_reduce_blanks
setopt hist_save_no_dups
setopt hist_no_store
setopt hist_expand
setopt share_history

# Completion behavior
LISTMAX=50
unsetopt bg_nice
setopt list_packed
setopt no_beep
unsetopt list_types

# zsh completion
autoload -Uz compinit
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'
mkdir -p "$XDG_CACHE_HOME/zsh"
compinit -d "$XDG_CACHE_HOME/zsh/zcompdump"

# mise (multi-language version manager). Manages node, bun, and global npm
# CLIs (~/.config/mise/config.toml). Activate after compinit so completions
# register correctly.
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

# fzf (use fd as the underlying file/dir lister)
if command -v fd >/dev/null 2>&1; then
  export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
  export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
  export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
fi
if [[ -t 0 && -t 1 ]] && command -v fzf >/dev/null 2>&1; then
  source <(fzf --zsh)
fi

# zoxide
if [[ -t 0 && -t 1 ]] && command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh --cmd cd)"
fi

# atuin
if [[ -t 0 && -t 1 ]] && command -v atuin >/dev/null 2>&1; then
  eval "$(atuin init zsh)"
fi

# starship
if [[ -t 1 ]] && command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

# zsh-autosuggestions
if [ -f /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]; then
  source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
fi

# Claude Code
export CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1

# Aliases
if command -v eza >/dev/null 2>&1; then
  alias ls='eza --icons --git'
  alias ll='eza -l --icons --git --time-style=long-iso'
  alias la='eza -la --icons --git'
  alias tree='eza --tree --icons'
fi

if command -v bat >/dev/null 2>&1; then
  alias cat='bat --paging=never'
fi

alias g='git'
alias lg='lazygit'
alias gst='git status'
alias gsw='git switch'
alias gbr='git branch'
alias gfe='git fetch'
alias gpl='git pull'
alias gad='git add'
alias gcm='git commit'
alias gmg='git merge'
alias gpsh='git push'

# A bare `herdr` reattaches to its persistent session. Before attaching, select
# the workspace for this Git checkout (or create it) so the sidebar Git context
# follows the project from which Herdr was launched. Subcommands and launches
# from inside Herdr keep the upstream CLI behavior unchanged.
if command -v herdr >/dev/null 2>&1; then
  function herdr() {
    if (( $# == 0 )) && [[ -z ${HERDR_ENV:-} ]] && command -v herdr-project >/dev/null 2>&1; then
      command herdr-project "$PWD"
    fi
    command herdr "$@"
  }
fi

# ghq + fzf
if [[ -t 0 && -t 1 ]] && command -v ghq >/dev/null 2>&1 && command -v fzf >/dev/null 2>&1; then
  function ghq-fzf() {
    local selected
    selected=$(ghq list | fzf --query="$LBUFFER" --prompt="repo > ")
    if [ -n "$selected" ]; then
      BUFFER="cd $(ghq root)/${selected}"
      zle accept-line
    fi
    zle reset-prompt
  }
  zle -N ghq-fzf
  bindkey '^]' ghq-fzf
fi

# gwq (git worktree manager). Completion script also provides the in-shell
# `cd` wrapper when cd.launch_shell = false (~/.config/gwq/config.toml).
if [[ -t 0 && -t 1 ]] && command -v gwq >/dev/null 2>&1; then
  source <(gwq completion zsh)
fi

# yazi: `y` opens yazi and cd's to its last directory on exit.
if command -v yazi >/dev/null 2>&1; then
  function y() {
    local tmp cwd
    tmp="$(mktemp -t yazi-cwd.XXXXXX)"
    yazi "$@" --cwd-file="$tmp"
    IFS= read -r -d '' cwd < "$tmp"
    [ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && builtin cd -- "$cwd"
    rm -f -- "$tmp"
  }
fi

# zsh-fast-syntax-highlighting (must be sourced last)
if [ -f /opt/homebrew/share/zsh-fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh ]; then
  source /opt/homebrew/share/zsh-fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh
fi
