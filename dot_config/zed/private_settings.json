// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "languages": {
    "Markdown": {
      "soft_wrap": "bounded",
      "preferred_line_length": 90,
      "show_wrap_guides": false,
      "hard_tabs": false,
      "remove_trailing_whitespace_on_save": false,
      "show_whitespaces": "selection",
      "format_on_save": "off"
    }
  },
  // Markdown preview: editor とは独立にフォント/テーマを指定できる
  // (v1.1.2 / 2026-04-29 以降。PR #54003)
  // あずきフォントは ~/Library/Fonts/azuki.ttf を別途配置すること
  "markdown_preview_font_family": "あずきフォント",
  "markdown_preview_theme": "One Dark",
  "buffer_font_family": ".ZedMono",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "ui_font_weight": 400.0,
  "buffer_line_height": "comfortable",
  "buffer_font_weight": 400.0,
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "base_keymap": "VSCode",
  "ui_font_size": 18.0,
  "buffer_font_size": 15.0,
  "theme": {
    "mode": "system",
    "light": "One Dark",
    "dark": "One Dark"
  },
}
