{
  "tui": "fullscreen",
  "theme": "auto",
  "model": "claude-fable-5[1m]",
  "statusLine": {
    "type": "command",
    "command": "python3 ~/.claude/status-line.py"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "claude-community": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-community"
      }
    }
  },
  "enabledPlugins": {
    "eli5@claude-community": true
  }
}
